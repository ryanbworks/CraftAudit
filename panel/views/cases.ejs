<%- include('partials/header', { title: 'Casos' }) %>
<section class="card">
  <div class="row">
    <h2>Casos</h2>
    <nav class="tabs">
      <% for (const [s, label] of [['open', 'Abertos'], ['closed', 'Encerrados'], ['all', 'Todos']]) { %>
        <a href="?status=<%= s %>" class="<%= status === s ? 'active' : '' %>"><%= label %></a>
      <% } %>
    </nav>
  </div>
  <% if (user.role === 'admin') { %>
  <form method="post" action="/cases" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="title" maxlength="100" placeholder="Ex.: Roubo na base do Pedro" required>
    <button>Criar caso</button>
  </form>
  <% } %>
  <% if (!cases.length) { %><p class="muted">Nenhum caso.</p><% } else { %>
  <table>
    <thead><tr><th>Nº</th><th>Status</th><th>Título</th><th>Envolvidos</th><th>Evidências</th><th>Criado por</th><th>Criado em</th></tr></thead>
    <tbody>
    <% for (const c of cases) { %>
      <tr>
        <td><a href="/cases/<%= c.id %>"><%= caseNo(c.id) %></a></td>
        <td><span class="badge <%= c.status %>"><%= c.status === 'open' ? 'Aberto' : 'Encerrado' %></span></td>
        <td><%= c.title %></td><td><%= c.player_count %></td><td><%= c.evidence_count %></td>
        <td><%= c.created_by %></td><td><%= fmtTime(c.created_ms) %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</section>
<%- include('partials/footer') %>
